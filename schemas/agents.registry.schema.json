{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-ai-config/agents.registry.schema.json",
  "title": "Portable Agent Registry",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "scope", "required_context", "allowed_tools", "deliverable", "escalation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "role": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "required_context": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "allowed_tools": { "type": "array", "items": { "type": "string" } },
          "deliverable": { "type": "string", "minLength": 1 },
          "escalation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
