{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/my-ai-config/permissions.schema.json",
  "title": "Agentic Permissions Policy",
  "type": "object",
  "required": ["version", "defaults", "capabilities", "rules"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "defaults": {
      "type": "object",
      "required": ["approval_required", "persist_secrets", "destructive_actions"],
      "properties": {
        "approval_required": { "type": "boolean" },
        "persist_secrets": { "type": "boolean", "const": false },
        "destructive_actions": { "type": "string", "enum": ["deny", "allow", "approval"] }
      }
    },
    "capabilities": { "type": "object", "minProperties": 1 },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
